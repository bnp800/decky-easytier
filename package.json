{
  "name": "decky-easytier",
  "version": "2.0.0",
  "description": "Native EasyTier profile and process manager for Steam Deck",
  "type": "module",
  "packageManager": "pnpm@9.15.4",
  "scripts": {
    "build": "rollup -c",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test test_profile_toml.test.ts",
    "check": "pnpm typecheck && pnpm test && pnpm build",
    "watch": "rollup -c -w",
    "deploy": "pnpm run build && decky plugin install"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bnp800/decky-easytier.git"
  },
  "author": "Decky EasyTier Contributors",
  "license": "GPL-3.0",
  "devDependencies": {
    "@decky/rollup": "^1.0.2",
    "@decky/ui": "^4.11.1",
    "@rollup/plugin-commonjs": "^29.0.0",
    "@rollup/plugin-json": "^6.1.0",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-replace": "^6.0.3",
    "@rollup/plugin-typescript": "^12.3.0",
    "@types/react": "19.1.1",
    "@types/react-dom": "19.1.1",
    "@types/webpack": "^5.28.5",
    "rollup": "^4.53.3",
    "tsx": "^4.20.6",
    "typescript": "^5.6.2"
  },
  "dependencies": {
    "@decky/api": "^1.1.3",
    "react-icons": "^5.3.0",
    "smol-toml": "^1.8.0",
    "tslib": "^2.7.0"
  }
}
